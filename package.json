{
  "name": "creativehub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @creativehub/api\" \"npm run dev -w @creativehub/web\"",
    "build": "npm run build -w @creativehub/shared && npm run build -w @creativehub/api && npm run build -w @creativehub/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "test": "npm run test -w @creativehub/api",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "email:worker": "node --env-file=.env scripts/email-worker.mjs",
    "admin:grant": "node --env-file=.env --import tsx scripts/admin.ts",
    "test:integration": "node --env-file=.env scripts/integration.mjs",
    "test:local": "node scripts/test-local.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.12.0",
    "concurrently": "^9.1.2",
    "pglite-server": "^0.1.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "overrides": {
    "rxjs": "7.8.2"
  }
}

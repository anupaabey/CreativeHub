{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "paths": {
      "rxjs": [
        "../../node_modules/rxjs"
      ],
      "rxjs/*": [
        "../../node_modules/rxjs/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
